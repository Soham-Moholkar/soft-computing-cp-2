{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".test-dist",
    "rootDir": ".",
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "lib/types.ts",
    "lib/parameters.ts",
    "lib/algorithms/**/*.ts",
    "data/syllabus.ts",
    "data/graph.ts",
    "services/**/*.ts"
  ]
}
