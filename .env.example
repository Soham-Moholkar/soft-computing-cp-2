NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Laboratories: actual API runs or explicitly labeled teaching mock mode.
NEXT_PUBLIC_SERVICE_MODE=api
NEXT_PUBLIC_API_BASE_URL=/api/backend
# Server only. In a hosted frontend, use the reachable HTTPS backend origin.
SOFTGRAPH_BACKEND_URL=http://127.0.0.1:8000

# Backend environment; the backend does not automatically load this file.
# SOFTGRAPH_INGESTION_DB=/data/course.sqlite3
# SOFTGRAPH_ENV=production
# SOFTGRAPH_CORS_ORIGINS=https://your-app.example
# SOFTGRAPH_SESSION_SECRET=<random secret, at least 32 characters>
# SOFTGRAPH_USERS={"owner":{"key":"<random key, at least 32 characters>","role":"editor","workspaces":["healthcare","agriculture","engineering","finance","personal","course"]}}
# Optional backend-only provider settings; workspace dashboard keeps provider off.
# OPENROUTER_API_KEY=<server-only key>
# SOFTGRAPH_OPENROUTER_MODEL=openrouter/free
# SOFTGRAPH_OPENROUTER_DAILY_BUDGET=10
# SOFTGRAPH_RANKER_ARTIFACT=<reviewed, promoted course artifact only>
